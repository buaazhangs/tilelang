#include <tl_templates/ascend/common.h>
#include <tl_templates/ascend/debug.h>
#include <tl_templates/ascend/simd_inst.h>
__simd_vf__ inline void main_kernel_simd_vf_0(__ubuf__ uint8_t* buf_dyn_shmem) {
  vector_bool mask = asc_create_mask_b32(PAT_ALL);
  auto vreg_0 = simd_inst::vdup<float>(float(0x0p+0f/*0.000000e+00*/), mask, MODE_ZEROING);
  simd_inst::vsts_norm(vreg_0, (__ubuf__ float*)(&(((__ubuf__ float*)buf_dyn_shmem)[16640])), 0, mask);
}

__simd_vf__ inline void main_kernel_simd_vf_1(__ubuf__ uint8_t* buf_dyn_shmem, int32_t half) {
  vector_f32 acc;
  vector_bool mask32 = asc_create_mask_b32(PAT_ALL);
  vector_bool one = asc_create_mask_b32(PAT_VL1);
  for (int32_t r = 0; r < 32; ++r) {
    vector_bool v = asc_create_mask_b32(PAT_ALL);
    acc = simd_inst::vdup<float>(float(0x0p+0f/*0.000000e+00*/), v, MODE_ZEROING);
    #pragma unroll
    for (int32_t c = 0; c < 4; ++c) {
      auto o_v = simd_inst::vlds_norm<bfloat16_t>((__ubuf__ bfloat16_t*)(&(((__ubuf__ bfloat16_t*)buf_dyn_shmem)[((r * 512) + (c * 128))])), 0);
      auto do_v = simd_inst::vlds_norm<bfloat16_t>((__ubuf__ bfloat16_t*)(&(((__ubuf__ bfloat16_t*)buf_dyn_shmem)[(((r * 512) + (c * 128)) + 16384)])), 0);
      vector_bool v_1 = asc_create_mask_b16(PAT_ALL);
      auto o0 = simd_inst::vcvt<float>(o_v, v_1, PART_EVEN, MODE_ZEROING);
      auto o1 = simd_inst::vcvt<float>(o_v, v_1, PART_ODD, MODE_ZEROING);
      auto do0 = simd_inst::vcvt<float>(do_v, v_1, PART_EVEN, MODE_ZEROING);
      auto do1 = simd_inst::vcvt<float>(do_v, v_1, PART_ODD, MODE_ZEROING);
      auto prod = simd_inst::vadd(simd_inst::vmul(o0, do0, mask32, MODE_ZEROING), simd_inst::vmul(o1, do1, mask32, MODE_ZEROING), mask32, MODE_ZEROING);
      acc = simd_inst::vadd(acc, prod, mask32, MODE_ZEROING);
    }
    auto row_sum = simd_inst::vcadd(acc, mask32, MODE_ZEROING);
    simd_inst::vsts_1st(row_sum, (__ubuf__ float*)(&(((__ubuf__ float*)buf_dyn_shmem)[(((half * 32) + r) + 16448)])), 0, one);
  }
}

__simd_vf__ inline void main_kernel_simd_vf_2(__ubuf__ uint8_t* buf_dyn_shmem) {
  vector_bool mask32 = asc_create_mask_b32(PAT_ALL);
  vector_bool v = asc_create_mask_b32(PAT_ALL);
  auto zero = simd_inst::vdup<float>(float(0x0p+0f/*0.000000e+00*/), v, MODE_ZEROING);
  auto l_v = simd_inst::vlds_norm<float>((__ubuf__ float*)(&(((__ubuf__ float*)buf_dyn_shmem)[16384])), 0);
  auto d_v = simd_inst::vlds_norm<float>((__ubuf__ float*)(&(((__ubuf__ float*)buf_dyn_shmem)[16448])), 0);
  auto s_v = simd_inst::vlds_norm<float>((__ubuf__ float*)(&(((__ubuf__ float*)buf_dyn_shmem)[16576])), 0);
  auto ds_v = simd_inst::vlds_norm<float>((__ubuf__ float*)(&(((__ubuf__ float*)buf_dyn_shmem)[16640])), 0);
  auto l_inv = simd_inst::vcmps_gt(l_v, float(0x1.93e5939a08ceap+99f/*1.000000e+30*/), mask32);
  auto s_hi = simd_inst::vcmps_gt(s_v, float(0x1.93e5939a08ceap+99f/*1.000000e+30*/), mask32);
  auto s_lo = simd_inst::vcmps_lt(s_v, float(-0x1.93e5939a08ceap+99f/*-1.000000e+30*/), mask32);
  auto l_safe = simd_inst::vsel(zero, l_v, l_inv);
  auto s_safe = simd_inst::vsel(zero, s_v, s_hi);
  auto s_safe_1 = simd_inst::vsel(zero, s_safe, s_lo);
  auto m = simd_inst::vmax(l_safe, s_safe_1, mask32, MODE_ZEROING);
  auto ex = simd_inst::vadd(simd_inst::vexpdif(l_safe, m, mask32), simd_inst::vexpdif(s_safe_1, m, mask32), mask32, MODE_ZEROING);
  auto lt_fin = simd_inst::vadd(m, simd_inst::vln(ex, mask32, MODE_ZEROING), mask32, MODE_ZEROING);
  auto contrib = simd_inst::vmul(simd_inst::vexpdif(s_safe_1, lt_fin, mask32), d_v, mask32, MODE_ZEROING);
  auto lt = simd_inst::vsel(l_v, lt_fin, s_lo);
  auto lt_1 = simd_inst::vsel(s_v, lt, s_hi);
  auto lt_2 = simd_inst::vsel(l_v, lt_1, l_inv);
  auto contrib_1 = simd_inst::vsel(zero, contrib, s_lo);
  auto contrib_2 = simd_inst::vsel(zero, contrib_1, s_hi);
  auto contrib_3 = simd_inst::vsel(zero, contrib_2, l_inv);
  simd_inst::vsts_norm(lt_2, (__ubuf__ float*)(&(((__ubuf__ float*)buf_dyn_shmem)[16512])), 0, mask32);
  simd_inst::vsts_norm(simd_inst::vsub(ds_v, contrib_3, mask32, MODE_ZEROING), (__ubuf__ float*)(&(((__ubuf__ float*)buf_dyn_shmem)[16640])), 0, mask32);
}

extern "C" __global__ __vector__ void main_kernel(__gm__ float* Delta, __gm__ float* LSE, __gm__ float* LSE_tot, __gm__ bfloat16_t* O, __gm__ float* Sink, __gm__ bfloat16_t* dO, __gm__ float* dSink) {
  asc_init();
  __ubuf__ uint8_t *buf_dyn_shmem = (__ubuf__ uint8_t *)0;
  asc_sync_notify(PIPE_V, PIPE_MTE2, static_cast<event_t>(0));
  asc_sync_notify(PIPE_MTE3, PIPE_V, static_cast<event_t>(0));
  asc_sync_notify(PIPE_MTE3, PIPE_V, static_cast<event_t>(1));
  asc_sync_notify(PIPE_V, PIPE_MTE2, static_cast<event_t>(1));
  asc_copy_gm2ub_align((__ubuf__ uint8_t*)((&(((__ubuf__ float*)buf_dyn_shmem)[16576]))), (__gm__ uint8_t*)((&(Sink[0]))), 1, 256, 0, 0, 0, static_cast<asc_load_l2_cache_mode>(0), 256, 256);
  main_kernel_simd_vf_0(buf_dyn_shmem);
  for (int32_t job = 0; job < ((4167 - ((int32_t)block_idx)) / 72); ++job) {
    asc_sync_wait(PIPE_V, PIPE_MTE2, static_cast<event_t>(1));
    asc_copy_gm2ub_align((__ubuf__ uint8_t*)((&(((__ubuf__ float*)buf_dyn_shmem)[16384]))), (__gm__ uint8_t*)((&(LSE[((job * 4608) + (((int32_t)block_idx) * 64))]))), 1, 256, 0, 0, 0, static_cast<asc_load_l2_cache_mode>(0), 256, 256);
    for (int32_t half = 0; half < 2; ++half) {
      asc_sync_wait(PIPE_V, PIPE_MTE2, static_cast<event_t>(0));
      asc_copy_gm2ub_align((__ubuf__ uint8_t*)((&(((__ubuf__ bfloat16_t*)buf_dyn_shmem)[16384]))), (__gm__ uint8_t*)((&(dO[(((job * 2359296) + (((int32_t)block_idx) * 32768)) + (half * 16384))]))), 1, 32768, 0, 0, 0, static_cast<asc_load_l2_cache_mode>(0), 32768, 32768);
      asc_copy_gm2ub_align((__ubuf__ uint8_t*)((&(((__ubuf__ bfloat16_t*)buf_dyn_shmem)[0]))), (__gm__ uint8_t*)((&(O[(((job * 2359296) + (((int32_t)block_idx) * 32768)) + (half * 16384))]))), 1, 32768, 0, 0, 0, static_cast<asc_load_l2_cache_mode>(0), 32768, 32768);
      asc_sync_notify(PIPE_MTE2, PIPE_V, static_cast<event_t>(0));
      if (half == 0) {
        asc_sync_wait(PIPE_MTE3, PIPE_V, static_cast<event_t>(1));
      }
      asc_sync_wait(PIPE_MTE2, PIPE_V, static_cast<event_t>(0));
      main_kernel_simd_vf_1(buf_dyn_shmem, half);
      asc_sync_notify(PIPE_V, PIPE_MTE2, static_cast<event_t>(0));
      if (half == 1) {
        asc_sync_notify(PIPE_V, PIPE_MTE3, static_cast<event_t>(1));
      }
    }
    asc_sync_wait(PIPE_MTE3, PIPE_V, static_cast<event_t>(0));
    main_kernel_simd_vf_2(buf_dyn_shmem);
    asc_sync_notify(PIPE_V, PIPE_MTE3, static_cast<event_t>(0));
    asc_sync_notify(PIPE_V, PIPE_MTE2, static_cast<event_t>(1));
    asc_sync_wait(PIPE_V, PIPE_MTE3, static_cast<event_t>(1));
    asc_copy_ub2gm_align((__gm__ uint8_t*)((&(Delta[((job * 4608) + (((int32_t)block_idx) * 64))]))), (__ubuf__ uint8_t*)((&(((__ubuf__ float*)buf_dyn_shmem)[16448]))), 1, 256, static_cast<asc_store_l2_cache_mode>(4), 256, 256);
    asc_sync_notify(PIPE_MTE3, PIPE_V, static_cast<event_t>(1));
    asc_sync_wait(PIPE_V, PIPE_MTE3, static_cast<event_t>(0));
    asc_copy_ub2gm_align((__gm__ uint8_t*)((&(LSE_tot[((job * 4608) + (((int32_t)block_idx) * 64))]))), (__ubuf__ uint8_t*)((&(((__ubuf__ float*)buf_dyn_shmem)[16512]))), 1, 256, static_cast<asc_store_l2_cache_mode>(4), 256, 256);
    asc_sync_notify(PIPE_MTE3, PIPE_V, static_cast<event_t>(0));
  }
  asc_set_atomic_add_float();
  asc_copy_ub2gm_align((__gm__ uint8_t*)((&(dSink[0]))), (__ubuf__ uint8_t*)((&(((__ubuf__ float*)buf_dyn_shmem)[16640]))), 1, 256, static_cast<asc_store_l2_cache_mode>(4), 256, 256);
  asc_set_atomic_none();
  asc_sync_wait(PIPE_V, PIPE_MTE2, static_cast<event_t>(0));
  asc_sync_wait(PIPE_MTE3, PIPE_V, static_cast<event_t>(0));
  asc_sync_wait(PIPE_MTE3, PIPE_V, static_cast<event_t>(1));
  asc_sync_wait(PIPE_V, PIPE_MTE2, static_cast<event_t>(1));
}

