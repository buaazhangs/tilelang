{"id":"sh/e1or2hob","kind":"textbox","name":"P22_C00_011_text","position":{"left":75,"top":326,"width":1130,"height":46},"text":"其中 c = kᵥ − kᵤ + d，是整数","style":{"fontSize":28,"typeface":"Microsoft YaHei","color":"#60717D","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/z2x8vm5w","kind":"textbox","name":"P22_C00_012_text","position":{"left":75,"top":405,"width":1130,"height":55},"text":"若 c ≤ −1，由 rᵥ − rᵤ < II，左侧会小于 0，矛盾","style":{"fontSize":30,"typeface":"Microsoft YaHei","color":"#B84E46","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/n69gzito","kind":"textbox","name":"P22_C00_013_text","position":{"left":75,"top":481,"width":1130,"height":50},"text":"因此 c ≥ 0；增大 II 不会破坏这条数据约束","style":{"fontSize":30,"typeface":"Microsoft YaHei","color":"#54836A","bold":true,"alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/m50zqdc3","kind":"textbox","name":"P22_C00_014_text","position":{"left":75,"top":562,"width":1130,"height":50},"text":"资源绕回约束变松，容量约束不变；此证明不覆盖所有工程配置","style":{"fontSize":25,"typeface":"Microsoft YaHei","color":"#60717D","alignment":"left"},"geometry":"rect","lineWidth":0}
