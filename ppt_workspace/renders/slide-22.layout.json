{"id":"sh/cz690765","kind":"textbox","name":"P22_C00_009_text","position":{"left":75,"top":169,"width":1130,"height":55},"text":"基础模型：等待时长 ≥ 0，0 ≤ r < II","style":{"fontSize":31,"typeface":"Microsoft YaHei","color":"#60717D","alignment":"left"},"geometry":"rect","lineWidth":0},
